<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MindAttic.Browser</AssemblyName>
    <RootNamespace>MindAttic.Browser</RootNamespace>
    <Product>MindAttic Browser</Product>
    <!-- Embedded as the exe's Win32 icon; WPF windows with no Icon of their own inherit it. -->
    <ApplicationIcon>../../assets/browser.ico</ApplicationIcon>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- From C:\LocalNuGet (see NuGet.config): MindAttic.Capture repacks these with tools in that repo. -->
    <PackageReference Include="MindAttic.Capture.Wpf" Version="1.0.0" />
    <PackageReference Include="MindAttic.Capture.WebView2" Version="2.0.0" />
    <!-- From C:\LocalNuGet: the shared dark theme and DropdownMenu, packed from MindAttic.Components. -->
    <PackageReference Include="MindAttic.Components.Wpf" Version="5.0.0" />
    <PackageReference Include="MindAttic.Vault" Version="5.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <!-- AutoWebNav: the browser-automation toolkit (IBrowserSurface, WebView2BrowserSurface) the
         "Ask Claude" chat agent drives the live page through. MindAttic.Legion: shared Claude API
         credential store (MindAtticCredentialStore), reused instead of asking the user to set up
         a key twice. -->
    <PackageReference Include="AutoWebNav" Version="4.0.0" />
    <PackageReference Include="AutoWebNav.WebView2" Version="4.0.0" />
    <PackageReference Include="MindAttic.Legion" Version="26.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Browser.Tests" />
  </ItemGroup>

</Project>
