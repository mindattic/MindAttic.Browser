<Window x:Class="MindAttic.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        mc:McWindow.DarkTitleBar="True"
        Title="MindAttic Browser" Width="1600" Height="900" MinWidth="560" MinHeight="320"
        Background="{StaticResource McChrome}" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="BrowseBack" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="BrowseForward" />
        <KeyBinding Key="F5" Command="Refresh" />
        <KeyBinding Key="L" Modifiers="Control" Command="Search" />
        <KeyBinding Key="F12" Command="Properties" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="Print" />
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="MediaCommands.Record" />
        <KeyBinding Key="D" Modifiers="Control" Command="NavigationCommands.Favorites" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="ApplicationCommands.Help" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="BrowseBack" Executed="OnBack" />
        <CommandBinding Command="BrowseForward" Executed="OnForward" />
        <CommandBinding Command="Refresh" Executed="OnReload" />
        <CommandBinding Command="Search" Executed="OnFocusAddress" />
        <CommandBinding Command="Properties" Executed="OnDevTools" />
        <CommandBinding Command="Print" Executed="OnScreenshot" />
        <CommandBinding Command="MediaCommands.Record" Executed="OnRecord" />
        <CommandBinding Command="NavigationCommands.Favorites" Executed="OnToggleStar" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="OnSettings" />
    </Window.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource McChromeBorder}" BorderThickness="0,0,0,1" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <mc:AddressBar x:Name="AddressBar" Grid.Column="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CaptureState" Margin="4,0,8,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource McMuted}" />
                    <Button x:Name="StarButton" Style="{StaticResource McToolButton}" Content="&#xE734;" AutomationProperties.Name="Favorites" ToolTip="Favorites (Ctrl+D stars this page)" Click="OnStarMenu" />
                    <StackPanel x:Name="PinnedActions" Orientation="Horizontal" />
                    <Button x:Name="CogButton" Style="{StaticResource McToolButton}" Content="&#xE713;" AutomationProperties.Name="More actions" ToolTip="More actions" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="8,2" BorderBrush="{StaticResource McChromeBorder}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="Status" FontSize="11" Foreground="{StaticResource McMuted}" TextTrimming="CharacterEllipsis" />
        </Border>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="White" />
    </DockPanel>
</Window>
