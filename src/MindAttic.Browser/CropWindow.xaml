<Window x:Class="MindAttic.Browser.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop screenshot" WindowStyle="None" AllowsTransparency="True" Background="#E6101114"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
        <KeyBinding Key="Enter" Command="Save" />
        <KeyBinding Key="A" Modifiers="Control" Command="SelectAll" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCancel" />
        <CommandBinding Command="Save" Executed="OnSave" />
        <CommandBinding Command="SelectAll" Executed="OnWhole" />
    </Window.CommandBindings>
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" HorizontalAlignment="Center" Padding="10,6" CornerRadius="6" Background="{StaticResource MaChrome}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SizeText" Width="150" VerticalAlignment="Center" Foreground="{StaticResource MaMuted}" FontSize="12" />
                <Button Style="{StaticResource MaTextButton}" Content="Whole page" ToolTip="Select everything (Ctrl+A)" Click="OnWhole" />
                <Button Style="{StaticResource MaTextButton}" Content="Cancel" ToolTip="Discard (Esc)" Click="OnCancel" />
                <Button Style="{StaticResource MaTextButton}" Content="Save" ToolTip="Save and copy (Enter)" Click="OnSave" Background="{StaticResource MaAccent}" />
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" HorizontalAlignment="Center" Foreground="{StaticResource MaMuted}" FontSize="12"
                   Text="Drag to select what to keep. Drag the box to move it, its edges to resize. Enter saves, Esc cancels." />
        <Grid x:Name="Host" ClipToBounds="True">
            <Canvas x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Cursor="Cross"
                    MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
                <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                <Path x:Name="Shade" Fill="#A0000000" IsHitTestVisible="False" />
                <Rectangle x:Name="Frame" Stroke="White" StrokeThickness="1.5" StrokeDashArray="4 3" Cursor="SizeAll" Fill="Transparent" />
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
