<Window x:Class="MindAttic.Browser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        mc:McWindow.DarkTitleBar="True"
        Title="Settings — MindAttic Browser" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource McChrome}" Foreground="{StaticResource McText}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource McText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource McTextBox}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource McText}" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Home page" />
            <TextBox x:Name="HomePage" Grid.Column="1" Grid.ColumnSpan="2" />
            <TextBlock Grid.Row="1" Text="Search URL" ToolTip="{}{query} is replaced by what you type in the address bar" />
            <TextBox x:Name="SearchUrl" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ToolTip="{}{query} is replaced by what you type in the address bar" />
            <TextBlock Grid.Row="2" Text="Capture folder" />
            <TextBox x:Name="CaptureFolder" Grid.Row="2" Grid.Column="1" />
            <Button Grid.Row="2" Grid.Column="2" Margin="6,4,0,4" Style="{StaticResource McTextButton}" Content="Browse…" Click="OnBrowse" />
        </Grid>
        <TextBlock Margin="130,0,0,8" FontSize="11" Foreground="{StaticResource McMuted}" TextWrapping="Wrap"
                   Text="Screenshots and recordings go to &lt;folder&gt;\&lt;site&gt;\&lt;site&gt;_&lt;timestamp&gt;. A new folder applies to recordings from the next launch." />
        <CheckBox x:Name="CopyToClipboard" Content="Copy every screenshot and recording to the clipboard" />
        <CheckBox x:Name="CropScreenshots" Content="Open screenshots in the crop lightbox before saving" />
        <TextBlock x:Name="StorePath" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource McMuted}" TextWrapping="Wrap" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource McTextButton}" Content="Cancel" IsCancel="True" />
            <Button Style="{StaticResource McTextButton}" Content="Save" IsDefault="True" Background="{StaticResource McAccent}" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
