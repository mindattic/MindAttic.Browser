<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      MindAttic.Capture.* are not on nuget.org: build them into C:\LocalNuGet from the MindAttic.Capture repo
      (dotnet pack -c Release -o C:\LocalNuGet) before building this one.
    -->
    <add key="local" value="C:\LocalNuGet" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
